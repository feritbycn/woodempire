rules_version = '2';

// WOOD EMPIRE — Firestore güvenlik kuralları
// Firebase konsolu → Firestore Database → Rules sekmesine bu dosyanın tamamını yapıştırıp "Publish" deyin.
//
//   players/{uid}                  oyuncu özeti: yalnızca sahibi yazar; sahibi ve yöneticiler okur
//   players/{uid}/claimed/{giftId} alınmış hediyeler: sahibi bir kez oluşturur, değiştirilemez
//   usernames/{adKucukHarf}        benzersiz ad: bir kez oluşturulur, başkası alamaz, değiştirilemez
//   gifts/{id}                     hediyeler: yalnızca yönetici yazar; alıcısı (veya herkes için olanı) okur
//   saves/{uid}                    tam oyun kaydının yedeği (hesap aktarımı için): yalnızca sahibi yazar; sahibi ve yönetici okur
//   bans/{uid}                     askıya alma: yalnızca yönetici yazar; oyuncunun kendisi okur
//   backups/{id}                   yönetici yedekleri (sıfırlama/aktarım/silme öncesi): yalnızca yönetici
//   admins/{uid}                   yöneticiler: konsoldan elle eklenir, oyundan/panelden yazılamaz
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function validName(n) { return n is string && n.size() >= 3 && n.size() <= 16; }

    match /admins/{uid} {
      allow read: if isMe(uid);
      allow write: if false;
    }

    match /players/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow delete: if isMe(uid) || isAdmin();
      // Yönetici yalnızca adı değiştirebilir (ad değiştirme / hesap aktarımı); usernames kaydıyla birlikte yazılır.
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'nameLower']);
      // Oyuncu kendi özetini yazar. Ad (name/nameLower) değişiyorsa: daha önce adı olmamalı ve
      // aynı anda usernames/{nameLower} kaydı bu oyuncu adına oluşturulmuş olmalı (getAfter = toplu yazmanın sonucu).
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'nameLower', 'level', 'xp', 'money', 'gold', 'totalEarned', 'zones', 'zoneList',
             'speed', 'speedMax', 'workers', 'animals', 'logs', 'trees', 'trucks', 'playTime', 'noAds', 'premium', 'platform', 'version', 'lastSeen', 'createdAt'])
        && (
          request.resource.data.get('nameLower', null) == (resource == null ? null : resource.data.get('nameLower', null))
          || (
            (resource == null || resource.data.get('nameLower', null) == null)
            && validName(request.resource.data.name)
            && getAfter(/databases/$(db)/documents/usernames/$(request.resource.data.nameLower)).data.uid == uid
          )
        );

      match /claimed/{giftId} {
        allow read: if isMe(uid) || isAdmin();
        allow create: if isMe(uid) && exists(/databases/$(db)/documents/gifts/$(giftId));
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    match /saves/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['data', 'enc', 'size', 'level', 'at'])
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow delete: if isMe(uid) || isAdmin();
    }

    match /backups/{id} {
      allow read, write: if isAdmin();
    }

    match /bans/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /usernames/{name} {
      allow read: if signedIn();
      // Yalnızca yoksa oluşturulur (create zaten var olan belgeye uygulanmaz) → aynı ad ikinci kez alınamaz.
      // Aynı anda oyuncunun kendi kaydına da bu ad yazılmalı → bir oyuncu birden fazla ad kapatamaz.
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'at'])
        && validName(request.resource.data.name)
        && name.size() >= 3 && name.size() <= 16
        && getAfter(/databases/$(db)/documents/players/$(request.auth.uid)).data.nameLower == name;
      // Yönetici adı başka oyuncuya verebilir (ad değiştirme / hesap aktarımı)
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['uid', 'name', 'at']) && validName(request.resource.data.name);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /gifts/{id} {
      allow read: if isAdmin() || (signedIn() && (resource.data.to == request.auth.uid || resource.data.to == 'all'));
      allow create, update, delete: if isAdmin();
    }
  }
}
